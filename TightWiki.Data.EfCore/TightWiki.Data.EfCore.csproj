<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>2.38.0</Version>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
		<!--
			Relational is the shared abstraction that every relational provider (SqlServer, Npgsql, Sqlite, ...)
			builds on top of - it is what brings Fluent APIs like ToTable(schema:), UseCollation(...) and
			HasDefaultValue(...) into scope. It has no dependency on any specific provider (in particular, no
			SQLite dependency) and is safe to reference directly from this provider-agnostic project.
		-->
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
	</ItemGroup>

	<!--
		_Scaffold\ is a reference-only artifact regenerated by Generate-EfMigrations.ps1 (repo root) from the
		live SQLite schema (see Database-Providers-Plan.md, chapter 5). It is a raw "dotnet ef dbcontext
		scaffold" dump, not hand-tuned production code, and must never be compiled as part of this project.
	-->
	<ItemGroup>
		<Compile Remove="_Scaffold\**\*.cs" />
	</ItemGroup>

</Project>
