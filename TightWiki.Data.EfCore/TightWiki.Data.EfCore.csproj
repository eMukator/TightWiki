<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<Version>2.38.0</Version>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
		<!--
			Relational is the shared abstraction that every relational provider (SqlServer, Npgsql, Sqlite, ...)
			builds on top of - it is what brings Fluent APIs like ToTable(schema:), UseCollation(...) and
			HasDefaultValue(...) into scope. It has no dependency on any specific provider (in particular, no
			SQLite dependency) and is safe to reference directly from this provider-agnostic project.
		-->
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.10" />
	</ItemGroup>

	<!--
		Needed for the shared ITwXRepository interfaces / Tw* models (e.g. ITwDefaultsRepository, TwDefaultEmoji)
		that EfDefaultsRepository (Seeding\EfDefaultsRepository.cs) implements/returns - see
		Database-Providers-Plan.md chapter 4.6b. Note: as of this writing, TightWiki.Plugin.csproj still carries
		a PackageReference on NTDLS.SqliteDapperWrapper (ITwPageRepository.cs uses SqliteManagedInstance directly
		in 3 method signatures, out of scope for this project - see chapter 6, phase 2b), which this
		ProjectReference pulls in transitively (confirmed via "dotnet list package" with transitive packages included:
		Microsoft.Data.Sqlite.Core, NTDLS.SqliteDapperWrapper, Dapper, SQLitePCLRaw.*). None of that SQLite code
		is actually exercised by this project - EfDefaultsRepository only touches System.IO.Compression,
		System.Text.Json and the plain POCO models - but the *package reference* itself is present until
		ITwPageRepository stops depending on SqliteManagedInstance. Tracked as a known gap against the "no
		SQLite package in TightWiki.Data.EfCore" rule (chapter 9) rather than worked around here.
	-->
	<ItemGroup>
		<ProjectReference Include="..\TightWiki.Plugin\TightWiki.Plugin.csproj" />
	</ItemGroup>

	<!--
		_Scaffold\ is a reference-only artifact regenerated by Generate-EfMigrations.ps1 (repo root) from the
		live SQLite schema (see Database-Providers-Plan.md, chapter 5). It is a raw "dotnet ef dbcontext
		scaffold" dump, not hand-tuned production code, and must never be compiled as part of this project.
	-->
	<ItemGroup>
		<Compile Remove="_Scaffold\**\*.cs" />
	</ItemGroup>

</Project>
